{
  "name": "gymjs",
  "version": "0.1.0",
  "description": "An API standard for single-agent reinforcement learning environments",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.d.ts": {
      "import": "./dist/index.d.ts",
      "require": "./dist/index.d.cts"
    }
  },
  "files": [
    "dist/**"
  ],
  "repository": "thundraa/gymjs",
  "keywords": [
    "rl",
    "gym",
    "reinforcement learning"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "devDependencies": {
    "@types/node": "^24.3.3",
    "prettier": "^3.6.2",
    "rolldown": "^1.2.5",
    "rolldown-plugin-dts": "^0.28.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  },
  "optionalDependencies": {
    "@kmamal/sdl": "^0.11.13",
    "@napi-rs/canvas": "^0.1.83"
  }
}
